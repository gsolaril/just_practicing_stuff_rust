    todo!()
}

// --- check (do not modify) ---
assert_eq!(tally(&["a", "b", "a"]).get("a"), Some(&2));
assert_eq!(tally(&["x", "x", "x"]).get("x"), Some(&3));
assert_eq!(tally(&[]).len(), 0);
println!("Exercise 5.2 passed");
</VSCode.Cell>
