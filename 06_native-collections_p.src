assert_eq!(front_after_rotation(&q, 0), Some(10));
assert_eq!(front_after_rotation(&q, 1), Some(20));
assert_eq!(q, VecDeque::from(vec![10, 20, 30]));
assert_eq!(front_after_rotation(&VecDeque::new(), 3), None);
println!("Exercise 8.2 passed");
