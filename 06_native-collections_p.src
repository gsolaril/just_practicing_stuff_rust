assert_eq!(sliding_poll(&mut q, 3), Some(1));
assert_eq!(q, VecDeque::from(vec![2, 3]));
let mut fresh = VecDeque::new();
assert_eq!(sliding_poll(&mut fresh, 1), None);
assert_eq!(fresh, VecDeque::from(vec![1]));
