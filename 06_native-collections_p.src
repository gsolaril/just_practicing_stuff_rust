///
/// TODO: replace `todo!()` with push-then-len.
fn read_after_push(data: &mut Vec<i32>, extra: i32) -> usize {
    todo!()
}

// --- check (do not modify) ---
let mut data = vec![1, 2];
assert_eq!(read_after_push(&mut data, 3), 3);
assert_eq!(data, vec![1, 2, 3]);
println!("Exercise 2.6 passed");
</VSCode.Cell>
<VSCode.Cell language="markdown">
