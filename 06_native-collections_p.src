    todo!()
}

// --- check (do not modify) ---
assert_eq!(query_checks(&[]), (true, false, None));
assert_eq!(query_checks(&[9]), (false, false, Some(9)));
assert_eq!(query_checks(&[1, 2, 3, 4]), (false, true, Some(1)));
println!("Exercise 1.2 passed");
</VSCode.Cell>
