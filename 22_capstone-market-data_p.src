fn ops_action(h: (&'static str, i32)) -> &'static str {
    todo!()
}

// --- check (do not modify) ---
let (base, _log) = md_url_desk();
let rurl = md_redis_desk();
let pg_port = md_pg_desk();
assert_eq!(health(&base, &rurl, pg_port), ("ok", 0));
assert_eq!(ops_action(("ok", 0)), "serve");
