assert_eq!(top_by_qty(&probe).as_deref(), Some("BBB"));
let live = vec![
    MdFill { sym: "AAA".to_string(), px: 10.0, qty: 100 },
    MdFill { sym: "BBB".to_string(), px: 20.5, qty: 200 },
];
let v = vwap(&live).unwrap();
assert!(v > 10.0 && v < 20.5, "vwap between the two prices: {}", v);
