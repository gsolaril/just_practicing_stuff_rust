// --- check (do not modify) ---
let probe = vec![
    MdFill { sym: "AAA".to_string(), px: 10.0, qty: 100 },
    MdFill { sym: "BBB".to_string(), px: 20.0, qty: 300 },
];
assert_eq!(vwap(&probe), Some(17.5));
