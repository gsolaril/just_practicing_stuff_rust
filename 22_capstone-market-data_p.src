// --- check (do not modify) ---
let s = MdSummary { ingested: 2, cached: true, persisted: 2, vwap: 17.0 };
assert_eq!(md_report(&s),
    "market-data: 2 fills ingested, quote cached=true, 2 rows persisted, vwap 17.0000");
