    ///
    /// TODO: replace `todo!()` with the take + push + set.
    fn stamp(&self) {
        todo!()
    }
}
impl Drop for Pebble {
    fn drop(&mut self) {
        self.stamp(); // the destructor's one allowed move: &mut self
    }
}

