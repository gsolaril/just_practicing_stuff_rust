///
/// TODO: replace `todo!()` with the mutation and the return.
fn exclaim(mut text: String) -> String {
    todo!()
}

// --- check (do not modify) ---
assert_eq!(exclaim(String::from("hey")), "hey!");
assert_eq!(exclaim(String::new()), "!");
assert_eq!(exclaim(String::from("é")), "é!");
println!("Exercise 1.4 passed");
</VSCode.Cell>
