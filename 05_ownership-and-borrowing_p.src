///
/// TODO: replace `todo!()` with the arithmetic.
fn arithmetic_on_copy(point: (i32, i32)) -> (i32, i32, i32) {
    todo!()
}

// --- check (do not modify) ---
assert_eq!(arithmetic_on_copy((6, 2)), (8, 4, 12));
assert_eq!(arithmetic_on_copy((-3, 3)), (0, -6, -9));
assert_eq!(arithmetic_on_copy((0, 0)), (0, 0, 0));
println!("Exercise 2.3 passed");
</VSCode.Cell>
