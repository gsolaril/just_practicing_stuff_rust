///
/// TODO: replace `todo!()` with the in-place normalisation.
fn trim_in_place(text: &mut String) {
    todo!()
}

// --- check (do not modify) ---
let mut first = String::from("  hi  ");
trim_in_place(&mut first);
assert_eq!(first, "hi");
let mut second = String::from("tight");
trim_in_place(&mut second);
assert_eq!(second, "tight");
let mut third = String::from("   ");
trim_in_place(&mut third);
assert_eq!(third, "");
println!("Exercise 3.4 passed");
</VSCode.Cell>
