    todo!()
}

/// Return `a` then `b` concatenated, borrowing both.
///
/// TODO: replace `todo!()` with the borrowing build.
fn joined_borrow(a: &str, b: &str) -> String {
    todo!()
}

/// Return `a` then `b` concatenated, cloning both deliberately.
///
/// TODO: replace `todo!()` with the cloning build.
fn joined_clone(a: &String, b: &String) -> String {
    todo!()
}

// --- check (do not modify) ---
assert_eq!(joined_move(String::from("a"), String::from("b")), "ab");
assert_eq!(joined_borrow("a", "b"), "ab");
let x = String::from("a");
let y = String::from("b");
assert_eq!(joined_clone(&x, &y), "ab");
assert_eq!(x, "a");
assert_eq!(y, "b");
println!("Exercise 14.1 passed");
