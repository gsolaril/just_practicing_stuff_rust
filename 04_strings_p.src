    todo!()
}

// --- check (do not modify) ---
assert_eq!(widths(""), (0, 0));
assert_eq!(widths("abc"), (3, 3));
assert_eq!(widths("é"), (2, 1));
assert_eq!(widths("e\u{301}"), (3, 2));
assert_eq!(widths("👋🏽"), (8, 2));
println!("Exercise 14.1 passed");
</VSCode.Cell>
