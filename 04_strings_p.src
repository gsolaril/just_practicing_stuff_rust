    todo!()
}

// --- check (do not modify) ---
let mut buffer = String::from("abc");
ensure_capacity(&mut buffer, 64);
assert!(buffer.capacity() >= buffer.len() + 64);
assert_eq!(buffer, "abc");
assert_eq!(buffer.len(), 3);
