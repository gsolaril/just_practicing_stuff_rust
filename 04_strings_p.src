fn byte_count(text: &str) -> usize {
    todo!()
}

// --- check (do not modify) ---
assert_eq!(byte_count(""), 0);
assert_eq!(byte_count("hello"), 5);
assert_eq!(byte_count("héllo"), 6);
println!("Exercise 0.1 passed");
