// --- check (do not modify) ---
let position = std::sync::Arc::new(StdMutex::new(0i64));
let shifts: Vec<_> = (0..4)
    .map(|k| run_shift(std::sync::Arc::clone(&position), vec![k + 1; 10]))
    .collect();
for s in shifts {
    s.join().unwrap();
}
assert_eq!(*position.lock().unwrap(), 100); // 10x(1+2+3+4) across 4 joined shifts
